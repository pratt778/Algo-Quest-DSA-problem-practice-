<!-- values/themes.xml -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->


    <style name="Base.Theme.MyApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Colors -->
        <item name="colorPrimary">@color/gradient_primary</item>
        <item name="colorPrimaryVariant">@color/gradient_secondary</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary Colors -->
        <item name="colorSecondary">@color/vibrant_accent</item>
        <item name="colorSecondaryVariant">@color/vibrant_accent_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Surface Colors -->
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorSurfaceVariant">@color/surface_variant_light</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Background Colors -->
        <item name="colorBackground">@color/background_light</item>
        <item name="colorOnBackground">@color/text_primary</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>

        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">?attr/colorBackground</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Typography -->

        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.MyApp.Headline.Large</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.MyApp.Headline.Medium</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.MyApp.Title.Large</item>

        <!-- Shape & Elevation -->


        <!-- Animation -->


        <!-- Ripple Effect -->
        <item name="android:colorControlHighlight">@color/ripple_light</item>
    </style>

    <style name="Theme.MyApp" parent="Base.Theme.MyApp" />

    <!-- Dark theme variant -->
    <style name="Theme.MyApp.Dark" parent="Base.Theme.MyApp">
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorSurfaceVariant">@color/surface_variant_dark</item>
        <item name="colorBackground">@color/background_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="colorOnBackground">@color/text_primary_dark</item>
        <item name="android:colorControlHighlight">@color/ripple_dark</item>
    </style>

    <!-- Custom Text Appearances -->
    <style name="TextAppearance.MyApp.Headline.Large" parent="TextAppearance.Material3.HeadlineLarge">

        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.MyApp.Headline.Medium" parent="TextAppearance.Material3.HeadlineMedium">

        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.MyApp.Title.Large" parent="TextAppearance.Material3.TitleLarge">

    </style>

</resources>